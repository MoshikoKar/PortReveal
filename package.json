{
  "name": "portreveal",
  "version": "1.0.0",
  "private": true,
  "description": "PortReveal — continuous network discovery, service inventory and change detection built around Nmap",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:capture-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-capture-tools.ps1",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs backend",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 -Mode production",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 -Mode dev",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 -Mode production -Stop",
    "test": "node scripts/py.mjs -m pytest -q",
    "test:e2e": "npm run build && node scripts/py.mjs -m pytest -q -m e2e",
    "test:frontend": "npm run test -w frontend",
    "lint": "node scripts/py.mjs -m ruff check . && tsc -p frontend && eslint -c frontend/eslint.config.js frontend/src",
    "build": "tsc -p frontend && vite build frontend",
    "db:migrate": "node scripts/py.mjs -m app.cli migrate",
    "db:reset": "node scripts/py.mjs -m app.cli reset-db",
    "mock:reset": "node scripts/py.mjs -m app.cli mock-reset",
    "cli": "node scripts/py.mjs -m app.cli"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
