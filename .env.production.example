# Network Finder - production configuration for Docker Compose (Linux host only).
#   cp .env.production.example .env   and edit the values below.
# Never commit the resulting .env file.
#
# Firewall / network (outside this file):
#   - Build egress: allow storage.googleapis.com:443 (Playwright Chromium download).
#     Optional: set HTTP_PROXY / HTTPS_PROXY below if the host uses an HTTP proxy.
#   - Inbound TCP APP_PORT on the host (default 8080) from clients that use the UI.
#   - Host must sit on the LAN you scan (e.g. 10.10.0.0/16) for ARP/MAC discovery.
#     Routed scopes (e.g. 10.0.0.0/16 via a gateway) are scanned without MACs.
#   - Network CIDRs themselves are configured in the first-run wizard / Settings, not here.

# PostgreSQL (container "db"). Change the password!
POSTGRES_DB=netfinder
POSTGRES_USER=netfinder
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port the database listens on (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# Web UI port on the Docker host (the app container uses host networking)
APP_PORT=8080

# Encrypts stored SMTP/LDAP passwords. Generate with:  openssl rand -hex 32
# If empty, a key is generated once and kept in the app data volume.
APP_SECRET_KEY=

# Scanner: nmap (production) or mock (demo only - the UI labels mock data clearly)
SCANNER_MODE=nmap

# Set to true when the UI is served over HTTPS (reverse proxy)
COOKIE_SECURE=false
# Comma separated IPs of trusted reverse proxies (for X-Forwarded-For / -Proto)
FORWARDED_ALLOW_IPS=127.0.0.1

# Local timezone used for the scan schedule and email timestamps
TZ=UTC

LOG_LEVEL=INFO
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24

# Optional: only if the Linux host must use an HTTP(S) proxy to reach the internet
# (including storage.googleapis.com during `docker compose build`).
# HTTP_PROXY=http://proxy.example.local:8080
# HTTPS_PROXY=http://proxy.example.local:8080
# NO_PROXY=localhost,127.0.0.1
