# PortReveal - production configuration for Docker Compose (Linux host only).
#   cp .env.production.example .env   and edit the values below.
# Never commit the resulting .env file.
#
# Firewall / network (outside this file):
#   - Build egress: allow storage.googleapis.com:443 (Playwright Chromium download).
#     Optional: set HTTP_PROXY / HTTPS_PROXY below if the host uses an HTTP proxy.
#   - Inbound TCP APP_PORT on the host (default 8081) from clients that use the UI.
#   - Host must sit on the same L2 LAN you scan for ARP/MAC discovery.
#     Routed scopes (reached via a gateway) are scanned without MACs.
#   - Network CIDRs themselves are configured in the first-run wizard / Settings, not here.

# PostgreSQL (container "db"). Change the password!
POSTGRES_DB=netfinder
POSTGRES_USER=netfinder
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port the database listens on (bound to 127.0.0.1 only)
POSTGRES_PORT=5434

# Web UI port on the Docker host (the app container uses host networking)
APP_PORT=8081

# REQUIRED. Encrypts stored SMTP/LDAP passwords. Generate with:  openssl rand -hex 32
# The app refuses to start in production while this is empty or still the placeholder.
# Back it up with the database: without it, restored SMTP/LDAP passwords cannot be decrypted.
APP_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Scanner: nmap (production) or mock (demo only - the UI labels mock data clearly)
SCANNER_MODE=nmap
# Only needed when the app runs in a bridged container (Docker Desktop override): the Docker
# host's own LAN IPv4 address(es), comma separated, so self-scans are recognised. Local
# interface addresses are detected automatically.
# SCANNER_HOST_IPS=192.0.2.10

# Session/CSRF Secure cookies. Required true in production unless COOKIE_ALLOW_HTTP=true.
# Terminate TLS at a reverse proxy for any non-localhost clients; then set COOKIE_SECURE=true
# and FORWARDED_ALLOW_IPS to the proxy. Plain HTTP on a trusted LAN only: COOKIE_ALLOW_HTTP=true.
COOKIE_SECURE=true
# COOKIE_ALLOW_HTTP=true
# Comma separated IPs of trusted reverse proxies (for X-Forwarded-For / -Proto)
FORWARDED_ALLOW_IPS=127.0.0.1

# Local timezone used for the scan schedule and email timestamps
TZ=UTC

# Container resource limits (Linux Docker Compose; see README "Availability and capacity")
# APP_MEM_LIMIT=3g
# APP_CPUS=4
# DB_MEM_LIMIT=1g
# DB_CPUS=2

LOG_LEVEL=INFO
# json (recommended): newline-delimited records with request_id, service, version and host fields
# for log collectors. Set text only for a human-read console.
LOG_FORMAT=json
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24

# Optional: only if the Linux host must use an HTTP(S) proxy to reach the internet
# (including storage.googleapis.com during `docker compose build`).
# HTTP_PROXY=http://proxy.example.local:8080
# HTTPS_PROXY=http://proxy.example.local:8080
# NO_PROXY=localhost,127.0.0.1
