# Network Finder - development configuration.
# `npm run setup` / `npm run dev` copy this file to .env when .env does not exist.
# Everything has a safe default; an empty .env also works.
# For production (Docker Compose) use .env.production.example instead.

# development | production
APP_ENV=development
LOG_LEVEL=INFO
# API requests slower than this (milliseconds) are logged as warnings
SLOW_REQUEST_MS=1000

# Database. Development uses SQLite (created automatically).
# Relative SQLite paths are resolved from the repository root.
DATABASE_URL=sqlite:///./data/dev.db
# PostgreSQL example (same code, same schema):
# DATABASE_URL=postgresql+psycopg://netfinder:secret@127.0.0.1:5432/netfinder

# Scanner: mock | nmap | auto
#   mock - simulated, Nmap-like results (safe default for development, no network traffic)
#   nmap - real scans with the nmap executable
#   auto - nmap when the executable is found, otherwise mock
SCANNER_MODE=mock
NMAP_PATH=nmap
# auto | true | false - whether nmap runs with raw-socket privileges
NMAP_PRIVILEGED=auto
# Seconds of artificial delay per mock scan stage (makes progress visible in the UI)
MOCK_SCAN_DELAY=0.4

# Dev servers
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Development seed: creates an admin user, a "Mock Lab" network and queues a
# baseline scan when the database has no users. Ignored in production.
DEV_SEED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin

# Sessions / cookies
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
COOKIE_SECURE=false

# Used to encrypt stored SMTP/LDAP passwords. Auto-generated into ./data/.secret_key when empty.
APP_SECRET_KEY=

# Inventory import limits (web import and `cli import-data`); larger packages are refused before anything is wiped
# IMPORT_MAX_UPLOAD_MB=512
# IMPORT_MAX_UNCOMPRESSED_MB=8192
# IMPORT_MAX_ROWS=20000000
